# vcstool manifest for the hospital-sim master repository.
#   vcs import < hospital-sim.repos
# Paths are relative to this file. URLs are under the Bkrakshith account until an organisation exists;
# update them in one place here if the repos move.
repositories:
  hospital-sim-env:
    type: git
    url: https://github.com/Bkrakshith/hospital-sim-env.git
    version: main
  g1-brainco-description:
    type: git
    url: https://github.com/Bkrakshith/g1-brainco-description.git
    version: main
  g1-mujoco-sim:
    type: git
    url: https://github.com/Bkrakshith/g1-mujoco-sim.git
    version: main
  g1-isaac-sim:
    type: git
    url: https://github.com/Bkrakshith/g1-isaac-sim.git
    version: main
  g1-whole-body-rl:
    type: git
    url: https://github.com/Bkrakshith/g1-whole-body-rl.git
    version: main
  ros2_ws/src/hospital-sim-ros2:
    type: git
    url: https://github.com/Bkrakshith/hospital-sim-ros2.git
    version: main
  g1-webcam-teleop:
    type: git
    url: https://github.com/Bkrakshith/g1-webcam-teleop.git
    version: main
  hospital-sim-ui:
    type: git
    url: https://github.com/Bkrakshith/hospital-sim-ui.git
    version: main
